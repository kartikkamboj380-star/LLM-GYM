# Copy to .env. The app reads this file on the backend only.
# Leave all external keys empty for the working offline mock.

AI_PROVIDER=mock
AI_REQUEST_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1024
MEMORY_RETRIEVAL_LIMIT=4
CHAT_HISTORY_LIMIT=20

# Keep the database on local, ignored storage.
LLM_GYM_DATA_DIR=./data
# DATABASE_PATH=./data/llm_gym.db

# OpenAI GPT — API usage may cost money; chat subscriptions are not API credits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude — API access and billing are separate from claude.ai.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini — verify current API free-tier limits in your Google account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Another authorized OpenAI-compatible Chat Completions API.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=change-me

# Optional official Design Arena read-only leaderboard API (approval required).
DESIGNARENA_API_KEY=

# Optional mail.tm adapter for authorized testing only; not used by the mock UI.
MAILTM_BASE_URL=https://api.mail.tm
EMAIL_REQUEST_TIMEOUT=20
